#!/usr/bin/env bash
#
# plugin/ を .plugin へ固める。Claude デスクトップと Office アドインへ反映するときに使う。
#
#   bin/build-plugin            dist/jp-client-deliverables-<版>.plugin を作る
#   bin/build-plugin --check    作らずに、版とスキル数の確認だけ行う
#
# 作ったファイルをチャットへ渡し、インストールで差し替える。
# リポジトリを直しただけでは、Claude が読むスキルは変わらない。

set -euo pipefail

KIT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC="$KIT/plugin"
OUT="$KIT/dist"

[ -f "$SRC/.claude-plugin/plugin.json" ] || { echo "plugin.json がありません: $SRC" >&2; exit 2; }

NAME=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["name"])' "$SRC/.claude-plugin/plugin.json")
VER=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["version"])' "$SRC/.claude-plugin/plugin.json")

echo "プラグイン : $NAME"
echo "版         : $VER"

# --- スキルの点検 -------------------------------------------------
rc=0
count=0
for d in "$SRC"/skills/*/; do
  slug=$(basename "$d")
  count=$((count+1))
  if [ ! -f "$d/SKILL.md" ]; then
    echo "  ★ SKILL.md がありません: $slug" >&2; rc=1; continue
  fi
  name=$(sed -n 's/^name:[[:space:]]*//p' "$d/SKILL.md" | head -1)
  if [ "$name" != "$slug" ]; then
    echo "  ★ name とディレクトリ名が違います: $slug (name: $name)" >&2; rc=1
  fi
  if ! grep -q '^description:' "$d/SKILL.md"; then
    echo "  ★ description がありません: $slug" >&2; rc=1
  fi
done
echo "スキル     : $count 件"

# --- CHANGELOG に今の版があるか ------------------------------------
if ! grep -q "^## $VER " "$SRC/CHANGELOG.md" 2>/dev/null; then
  echo "  ★ CHANGELOG.md に $VER の見出しがありません" >&2; rc=1
fi

if [ "$rc" != 0 ]; then
  echo >&2
  echo "点検で問題が出たため、作成しません。" >&2
  exit 2
fi
echo "点検       : 問題なし"

if [ "${1:-}" = "--check" ]; then exit 0; fi

mkdir -p "$OUT"
FILE="$OUT/$NAME-$VER.plugin"
rm -f "$FILE"
( cd "$SRC" && zip -qr "$FILE" . -x "*.DS_Store" -x "*__pycache__/*" -x "*.pyc" )

# 版を付けない名前でも置いておく（毎回同じ名前で渡したいとき用）
cp "$FILE" "$OUT/$NAME.plugin"

echo
echo "作成しました"
echo "  $FILE"
echo "  $OUT/$NAME.plugin"
unzip -l "$FILE" | tail -1 | sed 's/^/  /'
echo
echo "次にやること"
echo "  1. できた .plugin を Claude のチャットへ渡す"
echo "  2. プレビューカードでインストールを押し、既存のものと差し替える"
echo "  3. Excel と PowerPoint のアドインでも、スラッシュでスキルを呼べることを確認する"
