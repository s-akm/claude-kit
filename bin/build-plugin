#!/usr/bin/env bash
#
# plugin/ を .plugin へパッケージ。Claude デスクトップと Office アドインへの反映に使用。
#
#   bin/build-plugin            dist/jp-client-deliverables-<版>.plugin を出力
#   bin/build-plugin --check    出力せず、バージョンとスキル数の検証のみ
#
# 出力したファイルをチャットへ渡し、インストールで差し替え。
# リポジトリの修正のみでは、Claude が読むスキルは未変更のまま。

set -euo pipefail

KIT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC="$KIT/plugin"
OUT="$KIT/dist"

[ -f "$SRC/.claude-plugin/plugin.json" ] || { echo "plugin.json がありません: $SRC" >&2; exit 2; }

NAME=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["name"])' "$SRC/.claude-plugin/plugin.json")
VER=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["version"])' "$SRC/.claude-plugin/plugin.json")

echo "プラグイン : $NAME"
echo "バージョン : $VER"

# --- スキルの検証 -------------------------------------------------
rc=0
count=0
for d in "$SRC"/skills/*/; do
  slug=$(basename "$d")
  count=$((count+1))
  if [ ! -f "$d/SKILL.md" ]; then
    echo "  NG SKILL.md 未検出: $slug" >&2; rc=1; continue
  fi
  name=$(sed -n 's/^name:[[:space:]]*//p' "$d/SKILL.md" | head -1)
  if [ "$name" != "$slug" ]; then
    echo "  NG name とディレクトリ名が不一致: $slug (name: $name)" >&2; rc=1
  fi
  if ! grep -q '^description:' "$d/SKILL.md"; then
    echo "  NG description 未記載: $slug" >&2; rc=1
  fi
done
echo "スキル     : $count 件"

# --- CHANGELOG に現バージョンの見出しがあるか ------------------------------------
if ! grep -q "^## $VER " "$SRC/CHANGELOG.md" 2>/dev/null; then
  echo "  NG CHANGELOG.md に $VER の見出しなし" >&2; rc=1
fi

if [ "$rc" != 0 ]; then
  echo >&2
  echo "検証に失敗したため、出力せず中断。" >&2
  exit 2
fi
echo "検証       : 問題なし"

if [ "${1:-}" = "--check" ]; then exit 0; fi

mkdir -p "$OUT"
FILE="$OUT/$NAME-$VER.plugin"
rm -f "$FILE"
( cd "$SRC" && zip -qr "$FILE" . -x "*.DS_Store" -x "*__pycache__/*" -x "*.pyc" )

# バージョンなしの名前でも出力（常に同じ名前で渡す用途）
cp "$FILE" "$OUT/$NAME.plugin"

echo
echo "出力完了"
echo "  $FILE"
echo "  $OUT/$NAME.plugin"
unzip -l "$FILE" | tail -1 | sed 's/^/  /'
echo
echo "次の手順"
echo "  1. 出力した .plugin を Claude のチャットへ渡す"
echo "  2. プレビューカードからインストールし、既存版と差し替え"
echo "  3. Excel と PowerPoint のアドインで、スラッシュからの呼び出しを確認"
