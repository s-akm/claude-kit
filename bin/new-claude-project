#!/usr/bin/env bash
#
# テンプレートから新しいプロジェクトディレクトリを作成。
# 既定は dry-run。--apply の指定時のみ書き込み。
# 同名ディレクトリが存在する場合は中断。

set -euo pipefail

KIT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEMPLATE="$KIT/template/claude-project"
WORKSPACE="${CLAUDE_WORKSPACE:-$HOME/workspace}"

usage() {
  cat <<USAGE
使い方: new-claude-project <プロジェクト名> [--apply] [--dest <ディレクトリ>]

  <プロジェクト名>        作成するディレクトリ名
  --apply         書き込みを実行（省略時は dry-run）
  --dest <path>   作成先の親ディレクトリ（既定: $WORKSPACE）

例:
  new-claude-project sample-pj            # 作成対象を表示
  new-claude-project sample-pj --apply    # 作成
USAGE
}

[ $# -ge 1 ] || { usage; exit 1; }
case "$1" in -h|--help) usage; exit 0;; -*) usage; exit 1;; esac

NAME="$1"; shift
APPLY=false
DEST_PARENT="$WORKSPACE"
while [ $# -gt 0 ]; do
  case "$1" in
    --apply) APPLY=true; shift;;
    --dest) DEST_PARENT="${2:?--dest には値が要ります}"; shift 2;;
    *) echo "不明な引数: $1" >&2; usage; exit 1;;
  esac
done

case "$NAME" in
  ""|*/*|.|..) echo "プロジェクト名にディレクトリ区切りは使用不可: $NAME" >&2; exit 1;;
esac

DEST="$DEST_PARENT/$NAME"

[ -d "$TEMPLATE" ] || { echo "テンプレート未検出: $TEMPLATE" >&2; exit 2; }

if [ -e "$DEST" ]; then
  echo "既存ディレクトリのため中断: $DEST" >&2
  exit 1
fi

FILES=$(cd "$TEMPLATE" && find . -type f -not -path './node_modules/*' -not -name '.DS_Store' | sed 's|^\./||' | sort)
COUNT=$(printf '%s\n' "$FILES" | grep -c . || true)

echo "作成先   : $DEST"
echo "テンプレ : $TEMPLATE"
echo "KIT パス : $KIT"
echo "ファイル : $COUNT 件"
echo

if [ "$APPLY" != true ]; then
  printf '%s\n' "$FILES" | sed 's|^|  |'
  echo
  echo "dry-run。作成するには --apply を指定。"
  exit 0
fi

mkdir -p "$DEST"
(cd "$TEMPLATE" && tar cf - \
  --exclude='./node_modules' \
  --exclude='.DS_Store' \
  .) | (cd "$DEST" && tar xf -)

# justfile に kit の場所を書き込み。
# プロジェクトと kit が同じ親ディレクトリの場合は相対パス。
# 相対パスなら、macOS 側と Cowork 側でマウント位置が異なっても同一の justfile が動作。
if [ -f "$DEST/justfile" ]; then
  if [ "$(dirname "$KIT")" = "$(cd "$DEST_PARENT" && pwd)" ]; then
    KIT_REF="../$(basename "$KIT")"
  else
    KIT_REF="$KIT"
  fi
  tmp="$DEST/.justfile.tmp"
  sed "s|__KIT_PATH__|$KIT_REF|g" "$DEST/justfile" > "$tmp" && mv "$tmp" "$DEST/justfile"
  echo "kit の参照: $KIT_REF"
fi

echo "作成完了: $DEST"
echo
echo "次の手順"
echo "  1. cd \"$DEST\""
echo "  2. npm ci                       # チェックツールの導入"
echo "  3. CLAUDE.md の採番規約と文体を記入"
echo "  4. git init && git add -A       # 内容を確認してからコミット"
