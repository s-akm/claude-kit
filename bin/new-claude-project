#!/usr/bin/env bash
#
# 新しい案件ディレクトリを、テンプレートから作る。
# 既定は表示のみ。--apply を付けたときだけ書き込む。
# 既に同名のディレクトリがある場合は何もしない。

set -euo pipefail

KIT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEMPLATE="$KIT/template/claude-project"
WORKSPACE="${CLAUDE_WORKSPACE:-$HOME/workspace}"

usage() {
  cat <<USAGE
使い方: new-claude-project <案件名> [--apply] [--dest <ディレクトリ>]

  <案件名>        作成するディレクトリ名
  --apply         実際に書き込む（省略時は表示のみ）
  --dest <path>   作成先の親ディレクトリ（既定: $WORKSPACE）

例:
  new-claude-project sample-pj            # 何を作るか表示する
  new-claude-project sample-pj --apply    # 作成する
USAGE
}

[ $# -ge 1 ] || { usage; exit 1; }
case "$1" in -h|--help) usage; exit 0;; -*) usage; exit 1;; esac

NAME="$1"; shift
APPLY=false
DEST_PARENT="$WORKSPACE"
while [ $# -gt 0 ]; do
  case "$1" in
    --apply) APPLY=true; shift;;
    --dest) DEST_PARENT="${2:?--dest には値が要ります}"; shift 2;;
    *) echo "不明な引数: $1" >&2; usage; exit 1;;
  esac
done

case "$NAME" in
  ""|*/*|.|..) echo "案件名にディレクトリ区切りは使えません: $NAME" >&2; exit 1;;
esac

DEST="$DEST_PARENT/$NAME"

[ -d "$TEMPLATE" ] || { echo "テンプレートがありません: $TEMPLATE" >&2; exit 2; }

if [ -e "$DEST" ]; then
  echo "既に存在します。何もしません: $DEST" >&2
  exit 1
fi

FILES=$(cd "$TEMPLATE" && find . -type f -not -path './node_modules/*' -not -name '.DS_Store' | sed 's|^\./||' | sort)
COUNT=$(printf '%s\n' "$FILES" | grep -c . || true)

echo "作成先   : $DEST"
echo "テンプレ : $TEMPLATE"
echo "KIT パス : $KIT"
echo "ファイル : $COUNT 件"
echo

if [ "$APPLY" != true ]; then
  printf '%s\n' "$FILES" | sed 's|^|  |'
  echo
  echo "表示のみです。作成するには --apply を付けてください。"
  exit 0
fi

mkdir -p "$DEST"
(cd "$TEMPLATE" && tar cf - \
  --exclude='./node_modules' \
  --exclude='.DS_Store' \
  .) | (cd "$DEST" && tar xf -)

# justfile に kit の場所を書き込む。
# 案件と kit が同じ親ディレクトリにあるときは相対パスにする。
# 相対にしておくと、macOS 側と Cowork 側でマウント位置が違っても同じ justfile が使える。
if [ -f "$DEST/justfile" ]; then
  if [ "$(dirname "$KIT")" = "$(cd "$DEST_PARENT" && pwd)" ]; then
    KIT_REF="../$(basename "$KIT")"
  else
    KIT_REF="$KIT"
  fi
  tmp="$DEST/.justfile.tmp"
  sed "s|__KIT_PATH__|$KIT_REF|g" "$DEST/justfile" > "$tmp" && mv "$tmp" "$DEST/justfile"
  echo "kit の参照: $KIT_REF"
fi

echo "作成しました: $DEST"
echo
echo "次にやること"
echo "  1. cd \"$DEST\""
echo "  2. npm ci                       # 検査ツールを入れる"
echo "  3. CLAUDE.md の採番規約と文体を埋める"
echo "  4. git init && git add -A       # コミットは内容を確認してから"
