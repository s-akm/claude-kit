{
  // 検査対象。受領資料・提出物・検査結果は対象外。
  "globs": [
    "**/*.md",
    "!node_modules",
    "!00_sources",
    "!80_deliverables",
    "!90_qa"
  ],
  "config": {
    // 1 行の長さ。日本語の表は長くなるため見ない。
    "MD013": false,

    // 表のパイプ位置をそろえる規則。日本語は文字幅が一定ではなく、
    // そろえたつもりでも指摘が出続けるため外す。
    "MD060": false,

    // 太字を見出し代わりに使う書き方。レビュー記録の「現状」「問題」「修正案」で
    // 意図して使っているため外す。
    "MD036": false,

    // 同じ見出し名の重複。別の節の下なら許す。
    "MD024": { "siblings_only": true },

    // HTML コメントで記入例の注記を書くため許す。
    "MD033": false,

    // 先頭が h1 でなくてもよい。
    "MD041": false
  }
}
